  greekText: "\u03A4\u03B1 \u03C0\u03AE\u03B3\u03B5\u03C2 \u03C0\u03B5\u03C1\u03AF\u03C6\u03B7\u03BC\u03B1!\u0395\u03C0\u03B9\u03B2\u03AF\u03C9\u03C3\u03B5\u03C2
    \u03B1\u03C0\u03CC \u03BC\u03B9\u03B1 \u03C3\u03BA\u03BB\u03AE\u03C1\u03B7 \u03BC\u03AC\u03C7\u03B7
    \u03C4\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE\u03C2.\u039F\u03B9 \u03A4\u03C1\u03CE\u03B5\u03C2
    \u03C6\u03AD\u03C1\u03BD\u03BF\u03C5\u03BD \u03B5\u03BD\u03B9\u03C3\u03C7\u03CD\u03C3\u03B5\u03B9\u03C2
