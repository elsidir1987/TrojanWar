--- !u!114 &2144656659
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2144656655}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7f651e82b100141a38fa60a6b54bf007, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  greekText: "\u03A4\u03B1 \u03C0\u03AE\u03B3\u03B5\u03C2 \u03C0\u03B5\u03C1\u03AF\u03C6\u03B7\u03BC\u03B1,
    \u03B1\u03BB\u03BB\u03AC \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2 \u03C4\u03CE\u03C1\u03B1
    \u03B1\u03B3\u03C1\u03B9\u03B5\u03CD\u03B5\u03B9. \u039F\u03B9 \u03A4\u03C1\u03CE\u03B5\u03C2
    \u03C6\u03AD\u03C1\u03BD\u03BF\u03C5\u03BD \u03B5\u03BD\u03B9\u03C3\u03C7\u03CD\u03C3\u03B5\u03B9\u03C2!\n\n<size=44><b>\u039D\u0395\u0391
    \u0391\u03A0\u0395\u0399\u039B\u0397: \u039A\u03A5\u039C\u0391\u03A4\u0391 \u0395\u03A7\u0398\u03A1\u03A9\u039D</b></size>\n\u039F\u03B9
    \u03B5\u03C7\u03B8\u03C1\u03BF\u03AF \u03C0\u03BB\u03AD\u03BF\u03BD \u03B8\u03B1
    \u03C3\u03BF\u03C5 \u03B5\u03C0\u03B9\u03C4\u03AF\u03B8\u03B5\u03BD\u03C4\u03B1\u03B9
    \u03B1\u03C0\u03CC <b>\u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AC
    \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1</b>. \u0388\u03C7\u03B5 \u03C4\u03B1 \u03BC\u03AC\u03C4\u03B9\u03B1
    \u03C3\u03BF\u03C5 \u03B1\u03BD\u03BF\u03B9\u03C7\u03C4\u03AC!\n\n<size=44><b>\u03A4\u0391\u039A\u03A4\u0399\u039A\u0397
    & \u0395\u03A0\u0399\u0392\u0399\u03A9\u03A3\u0397</b></size>\n\u2022 \u039C\u03B7\u03BD
    \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2 \u03C0\u03B5\u03C1\u03B9\u03C4\u03C4\u03AD\u03C2
    \u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9\u03C2. \u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03C3\u03BF\u03C5
    \u03C4\u03B7\u03BD <b>\u0395\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03AC</b> \u03C3\u03BF\u03C5
    \u03AD\u03BE\u03C5\u03C0\u03BD\u03B1.\n\u2022 \u0391\u03BD \u03B5\u03BE\u03B1\u03BD\u03C4\u03BB\u03B7\u03B8\u03B5\u03AF\u03C2,
    \u03C0\u03AC\u03C4\u03B1 \u03C4\u03BF <color=#E18C28><b>[ Fill Energy ]</b></color> 
    \u03BA\u03B1\u03B9 \u03B1\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B5 \u03C3\u03C9\u03C3\u03C4\u03AC
    \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03BA\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03B9\u03C2.\n\n<color=red><size=45><b>\u0397
    \u0395\u03A0\u0399\u0392\u0399\u03A9\u03A3\u0397 \u0391\u03A0\u0391\u0399\u03A4\u0395\u0399
    \u03A4\u0391\u039A\u03A4\u0399\u039A\u0397!</b></size></color>"
  englishText: "You did great, but the war is growing fiercer now. The Trojans are
    bringing reinforcements!\n\n<size=44>NEW THREAT: ENEMY WAVES\nEnemies will now
    attack you from different directions. Keep your eyes open!\n\n<size=44>TACTICS
    & SURVIVAL\n\u2022 Do not make unnecessary moves. Manage your Energy wisely.\n\u2022
    If you get exhausted, press <color=#E18C28>[ Fill Energy ] and answer correctly
    to regain your strength.\n\n<color=red><size=45>SURVIVAL REQUIRES TACTICS!"
