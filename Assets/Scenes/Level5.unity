  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u03A4\u03B1 \u03C4\u03B5\u03AF\u03C7\u03B7 \u03BB\u03CD\u03B3\u03B9\u03C3\u03B1\u03BD!\u0397
    \u03B8\u03C1\u03C5\u03BB\u03B9\u03BA\u03AE \u03AC\u03BC\u03C5\u03BD\u03B1 \u03C4\u03B7\u03C2
    \u03A4\u03C1\u03BF\u03AF\u03B1\u03C2 \u03B4\u03B9\u03B1\u03C3\u03C0\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5
    \u03BA\u03B1\u03B9 \u03BF \u0391\u03AF\u03B1\u03C2 \u03C0\u03B1\u03C4\u03AC\u03B5\u03B9
    \u03C0\u03BB\u03AD\u03BF\u03BD \u03C4\u03BF \u03AD\u03B4\u03B1\u03C6\u03BF\u03C2
    \u03C4\u03B7\u03C2 \u03C6\u03BB\u03B5\u03B3\u03CC\u03BC\u03B5\u03BD\u03B7\u03C2
    \u03C0\u03CC\u03BB\u03B7\u03C2. \u0397 \u03C0\u03BF\u03BB\u03B9\u03BF\u03C1\u03BA\u03AF\u03B1
    \u03C4\u03B5\u03BB\u03B5\u03AF\u03C9\u03C3\u03B5, \u03B1\u03BB\u03BB\u03AC \u03B7
    \u03BC\u03AC\u03C7\u03B7 \u03C4\u03CE\u03C1\u03B1 \u03BE\u03B5\u03BA\u03B9\u03BD\u03AC!
    \u0392\u03C1\u03AF\u03C3\u03BA\u03B5\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
    \u03BA\u03B1\u03C1\u03B4\u03B9\u03AC \u03C4\u03BF\u03C5 \u03B5\u03C7\u03B8\u03C1\u03BF\u03CD
    \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9
    \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE\u03C2.
    \u039F \u03A0\u03C1\u03AF\u03B1\u03BC\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9
    \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03BF\u03B9 \u03C5\u03C0\u03B5\u03C1\u03B1\u03C3\u03C0\u03B9\u03C3\u03C4\u03AD\u03C2
    \u03C3\u03B5 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD \u03B3\u03B9\u03B1
    \u03C4\u03B7\u03BD \u03C4\u03B5\u03BB\u03B9\u03BA\u03AE \u03B1\u03BD\u03B1\u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7.
    \u0395\u03C4\u03BF\u03B9\u03BC\u03AC\u03C3\u03BF\u03C5 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
    \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03B1 \u03C0\u03C1\u03AC\u03BE\u03B7
    \u03C4\u03B7\u03C2 \u03B4\u03CC\u03BE\u03B1\u03C2!"
