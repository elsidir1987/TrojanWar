  m_text: "\n\u0388\u03BC\u03B5\u03B9\u03BD\u03B5\u03C2 \u03B1\u03C0\u03CC <b>\u0395\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B1</b>!
    \u0391\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B5 \u03C3\u03C9\u03C3\u03C4\u03AC
    \u03C3\u03C4\u03B9\u03C2 \u03B5\u03C1\u03C9\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03B9\u03C2 \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03B9\u03C2 \u03C3\u03BF\u03C5.\n\n\u0391\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03BF\u03CD\u03BD
    <b>5 \u03B5\u03C1\u03C9\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2</b>. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2
    \u03BD\u03B1 \u03B4\u03B9\u03B1\u03BA\u03CC\u03C8\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
    \u03BD\u03B1 \u03B3\u03C5\u03C1\u03AF\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7
