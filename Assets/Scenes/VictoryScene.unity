--- !u!114 &528343132
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 528343128}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7f651e82b100141a38fa60a6b54bf007, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  greekText: "\u039C\u03B5\u03C4\u03AC \u03B1\u03C0\u03CC \u03B4\u03AD\u03BA\u03B1
    \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1 \u03B1\u03BD\u03B5\u03BB\u03AD\u03B7\u03C4\u03B7\u03C2
    \u03C0\u03BF\u03BB\u03B9\u03BF\u03C1\u03BA\u03AF\u03B1\u03C2, \u03C4\u03B1 \u03B1\u03C0\u03CC\u03C1\u03B8\u03B7\u03C4\u03B1
    \u03C4\u03B5\u03AF\u03C7\u03B7 \u03BA\u03B1\u03C4\u03AD\u03C1\u03C1\u03B5\u03C5\u03C3\u03B1\u03BD.
    \u039C\u03B5 \u03C4\u03BF \u03C3\u03C0\u03B1\u03B8\u03AF \u03C4\u03BF\u03C5 <b>\u0391\u03AF\u03B1\u03BD\u03C4\u03B1</b>,
    \u03BF\u03B9 \u0391\u03C7\u03B1\u03B9\u03BF\u03AF \u03B4\u03BF\u03BE\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03B1\u03B9\u03CE\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03B7 \u03B8\u03C1\u03C5\u03BB\u03B9\u03BA\u03AE
    \u03C0\u03CC\u03BB\u03B7 \u03C0\u03B1\u03C1\u03B1\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9
    \u03C3\u03C4\u03B9\u03C2 \u03C6\u03BB\u03CC\u03B3\u03B5\u03C2.\n\n<size=45><b>\u039F
    \u03BC\u03CD\u03B8\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03BC\u03CC\u03BB\u03B9\u03C2
    \u03B3\u03C1\u03AC\u03C6\u03C4\u03B7\u03BA\u03B5!\n\n\u03A3\u03C5\u03B3\u03C7\u03B1\u03C1\u03B7\u03C4\u03AE\u03C1\u03B9\u03B1
    \u03A0\u03BF\u03BB\u03B5\u03BC\u03B9\u03C3\u03C4\u03AE!</b></size>"
  englishText: 'After ten years of relentless siege, the impregnable walls have collapsed.
    With the sword of Ajax, the Achaeans are glorified for eternity, and the legendary
    city is surrendered to the flames.


    <size=45>Your myth has just been written!


    Congratulations,
    Warrior!'
