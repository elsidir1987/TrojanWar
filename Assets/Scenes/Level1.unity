--- !u!114 &796800438
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 796800436}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=40><b>\u0392\u0391\u03A3\u0399\u039A\u039F\u03A3 \u03A7\u0395\u0399\u03A1\u0399\u03A3\u039C\u039F\u03A3</b></size>\n\n<color=#E18C28><b>[
    A ] / [ D ]</b></color>: \u039A\u03AF\u03BD\u03B7\u03C3\u03B7 (\u0391\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03AC
    / \u0394\u03B5\u03BE\u03B9\u03AC)\n<color=#E18C28><b>[ W ]</b></color>: \u0386\u03BB\u03BC\u03B1
    \n<color=#E18C28><b>[ Space ]</b></color>: \u0395\u03C0\u03AF\u03B8\u03B5\u03C3\u03B7
    \u03BC\u03B5 \u03C4\u03BF \u03C3\u03C0\u03B1\u03B8\u03AF\n<color=#E18C28><b>[
    Left Shift ]</b></color>: \u0386\u03BC\u03C5\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B7\u03BD
    \u0391\u03C3\u03C0\u03AF\u03B4\u03B1\n\n<size=40><b>\u0395\u039D\u0395\u03A1\u0393\u0395\u0399\u0391
    & \u0395\u03A1\u03A9\u03A4\u0397\u03A3\u0395\u0399\u03A3</b></size>\n\u039A\u03AC\u03B8\u03B5
    \u03C3\u03BF\u03C5 \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7 \u03C3\u03C4\u03B7 \u03BC\u03AC\u03C7\u03B7
    \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9 <b>\u0395\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B1</b>.
    \u038C\u03C4\u03B1\u03BD \u03B5\u03BE\u03B1\u03BD\u03C4\u03BB\u03B7\u03B8\u03B5\u03AF,
    \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03B5\u03C0\u03B9\u03C4\u03B5\u03B8\u03B5\u03AF\u03C2
    \u03AE \u03BD\u03B1 \u03C0\u03B7\u03B4\u03AE\u03BE\u03B5\u03B9\u03C2.\n\u0393\u03B9\u03B1
    \u03BD\u03B1 \u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2,
    \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03B9\u03C2 \u03B3\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03BF\u03C5!
    <color=red><size=32>\u03A0\u03C1\u03CC\u03C3\u03B5\u03BE\u03B5</size></color>:
    \u03B1\u03BD \u03BF\u03B9 \u03B5\u03C1\u03C9\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03C3\u03BF\u03C5\u03BD, <b>\u03C7\u03AC\u03BD\u03B5\u03B9\u03C2</b>.\n<color=red><b>\u03A0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE:</b></color>
    \u039F\u03B9 \u03BB\u03AC\u03B8\u03BF\u03C2 \u03B1\u03C0\u03B1\u03BD\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03B8\u03B1 \u03C3\u03BF\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03C3\u03BF\u03C5\u03BD
    <b>\u0396\u03C9\u03AE</b>!\n\n<size=40><b>\u0395\u03A0\u0399\u0392\u0399\u03A9\u03A3\u0397</b></size>\n\u039F
    \u0391\u03AF\u03B1\u03C2 \u03AD\u03C7\u03B5\u03B9 <b>3 \u0396\u03C9\u03AD\u03C2</b>.
    \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B5
    \u03C4\u03B7\u03BD <b>\u03B1\u03C3\u03C0\u03AF\u03B4\u03B1</b> \u03C3\u03BF\u03C5
    \u03AD\u03BE\u03C5\u03C0\u03BD\u03B1 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03BA\u03C1\u03BF\u03CD\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03B1 \u03B2\u03AD\u03BB\u03B7, \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03C3\u03BF\u03C5
    \u03C3\u03C9\u03C3\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03AC
    \u03C3\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B5\u03BE\u03CC\u03BD\u03C4\u03C9\u03C3\u03B5
    \u03C4\u03BF\u03C5\u03C2 \u03B5\u03C7\u03B8\u03C1\u03BF\u03CD\u03C2."
  m_isRightToLeft: 0
