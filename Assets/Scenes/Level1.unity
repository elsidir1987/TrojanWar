--- !u!114 &208308259
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 208308255}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7f651e82b100141a38fa60a6b54bf007, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  greekText: "\u039A\u03B1\u03BB\u03CE\u03C2 \u03AE\u03C1\u03B8\u03B5\u03C2, \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03C3\u03C4\u03AE!
    \u0395\u03C4\u03BF\u03B9\u03BC\u03AC\u03C3\u03BF\u03C5 \u03BD\u03B1 \u03B6\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03BF \u03AD\u03C0\u03BF\u03C2 \u03C4\u03BF\u03C5 <b>\u03A4\u03C1\u03C9\u03B9\u03BA\u03BF\u03CD
    \u03A0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5</b> \u03BC\u03AD\u03C3\u03B1 \u03B1\u03C0\u03CC
    \u03C4\u03B1 \u03BC\u03AC\u03C4\u03B9\u03B1 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03BD\u03AF\u03C3\u03C7\u03C5\u03C1\u03BF\u03C5
    <b>\u0391\u03AF\u03B1\u03BD\u03C4\u03B1</b>. \u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
    \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03B4\u03CC\u03BE\u03B1, \u03CC\u03BC\u03C9\u03C2,
    \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03BC\u03C5\u03B1\u03BB\u03CC \u03BA\u03B1\u03B9
    \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7.\n\n<color=#E18C28><size=40><b>\u0395\u03A0\u0399\u03A0\u0395\u0394\u039F
    1: \u0397 \u0394\u039F\u039A\u0399\u039C\u0391\u03A3\u0399\u0391 \u03A4\u0397\u03A3
    \u0393\u039D\u03A9\u03A3\u0397\u03A3</b></size></color>\n\u03A0\u03C1\u03B9\u03BD
    \u03C0\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B1 \u03C0\u03B5\u03B4\u03AF\u03B1
    \u03C4\u03C9\u03BD \u03BC\u03B1\u03C7\u03CE\u03BD, \u03BF\u03B9 \u03B8\u03B5\u03BF\u03AF
    \u03C3\u03B5 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03B6\u03BF\u03C5\u03BD. \u0391\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B5
    \u03C3\u03C9\u03C3\u03C4\u03AC \u03C3\u03C4\u03B9\u03C2 <b>\u03B5\u03C1\u03C9\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2</b>
    \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03B4\u03B5\u03AF\u03BE\u03B5\u03B9\u03C2
    \u03C4\u03B7\u03BD \u03B1\u03BE\u03AF\u03B1 \u03C3\u03BF\u03C5. \n<color=red><b>\u03A0\u03C1\u03CC\u03C3\u03B5\u03C7\u03B5:</b></color>
    \u03A4\u03B1 \u03BB\u03AC\u03B8\u03B7 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03BF\u03C5\u03BD
    <b>\u03C0\u03BF\u03BB\u03CD\u03C4\u03B9\u03BC\u03B7 \u0396\u03C9\u03AE!</b>\n\n<color=#E18C28><size=40><b>\u0395\u03A0\u039F\u039C\u0395\u039D\u0391
    \u0395\u03A0\u0399\u03A0\u0395\u0394\u0391: \u0397 \u03A9\u03A1\u0391 \u03A4\u0397\u03A3
    \u039C\u0391\u03A7\u0397\u03A3</b></size></color>\n\u0391\u03C0\u03CC \u03C4\u03BF
    <b>2\u03BF \u0395\u03C0\u03AF\u03C0\u03B5\u03B4\u03BF</b> \u03BA\u03B1\u03B9
    \u03BC\u03B5\u03C4\u03AC, \u03C4\u03B1 \u03BB\u03CC\u03B3\u03B9\u03B1 \u03C3\u03C4\u03B1\u03BC\u03B1\u03C4\u03BF\u03CD\u03BD
    \u03BA\u03B1\u03B9 \u03BC\u03B9\u03BB\u03BF\u03CD\u03BD \u03C4\u03B1 \u03C3\u03C0\u03B1\u03B8\u03B9\u03AC!
    \u0391\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03CE\u03C0\u03B9\u03C3\u03B5 \u03C4\u03B9\u03C2
    \u03BF\u03C1\u03B4\u03AD\u03C2 \u03C4\u03C9\u03BD \u03A4\u03C1\u03CE\u03C9\u03BD
    \u03C3\u03B5 \u03BC\u03B9\u03B1 \u03BC\u03AC\u03C7\u03B7 \u03B5\u03C0\u03B9\u03B2\u03AF\u03C9\u03C3\u03B7\u03C2.
    \u038C\u03C3\u03BF \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AC\u03C2, \u03BF\u03B9
    \u03B5\u03C7\u03B8\u03C1\u03BF\u03AF \u03C0\u03BB\u03B7\u03B8\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
    \u03BA\u03B1\u03B9 \u03B7 <b>\u03B4\u03C5\u03C3\u03BA\u03BF\u03BB\u03AF\u03B1
    \u03BC\u03B5\u03B3\u03B1\u03BB\u03CE\u03BD\u03B5\u03B9</b>.\n\n<color=#E18C28><size=40><b>\u03A0\u03A1\u039F\u03A3\u039F\u03A7\u0397
    \u03A3\u03A4\u0397\u039D \u0395\u039D\u0395\u03A1\u0393\u0395\u0399\u0391 \u03A3\u039F\u03A5!</b></size></color>\n\u03A4\u03B1
    \u03AC\u03BB\u03BC\u03B1\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03C0\u03B9\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
    \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03BF\u03C5\u03BD. \u0391\u03BD \u03B7 \u03BC\u03C0\u03AC\u03C1\u03B1
    <b>\u0395\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03AC\u03C2</b> \u03C3\u03BF\u03C5
    \u03B1\u03B4\u03B5\u03B9\u03AC\u03C3\u03B5\u03B9, <b>\u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2
    \u03BD\u03B1 \u03C0\u03BF\u03BB\u03B5\u03BC\u03AE\u03C3\u03B5\u03B9\u03C2</b>!
    \u0393\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2
    \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B7
    \u03BC\u03AC\u03C7\u03B7, \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B1\u03C0\u03B1\u03BD\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03C3\u03C9\u03C3\u03C4\u03AC \u03C3\u03B5 <b>\u03AD\u03BE\u03C4\u03C1\u03B1
    \u03B5\u03C1\u03C9\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2</b>. \n\n<i>\u0397 \u03B3\u03BD\u03CE\u03C3\u03B7
    \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9 \u03C4\u03BF \u03C0\u03B9\u03BF
    \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC \u03C3\u03BF\u03C5 \u03CC\u03C0\u03BB\u03BF!</i>"
  englishText: "Welcome, warrior! Prepare to experience the epic of the <b>Trojan
    War</b> through the eyes of the mighty <b>Ajax</b>. The path to glory, however,
    requires both mind and might.\n\n<color=#E18C28><size=40><b>LEVEL 1: THE TRIAL
    OF KNOWLEDGE</b></size></color>\nBefore you step onto the battlefields, the gods
    will test you. Answer the <b>questions</b> correctly to prove your worth. \n<color=red><b>Warning:</b></color>
    Mistakes will cost you <b>precious Health!</b>\n\n<color=#E18C28><size=40><b>LATER
    LEVELS: TIME FOR BATTLE</b></size></color>\nFrom <b>Level 2</b> onwards, words
    stop and swords speak! Face the Trojan hordes in a battle for survival. As you
    progress, enemies will multiply and the <b>difficulty increases</b>.\n\n<color=#E18C28><size=40><b>WATCH
    YOUR ENERGY!</b></size></color>\nJumping and attacking cost energy. If your <b>Energy</b>
    bar depletes, <b>you cannot fight</b>! To replenish your strength in the heat
    of battle, you must correctly answer <b>extra questions</b>. \n\n<i>Knowledge
    remains your most powerful weapon!</i>"
